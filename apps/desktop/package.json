{
  "name": "@spatialmeet/desktop",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev:renderer": "vite",
    "dev:electron": "wait-on http://localhost:5173 && electron electron/main.cjs",
    "dev": "concurrently -k \"pnpm dev:renderer\" \"pnpm dev:electron\"",
    "build": "tsc --noEmit -p tsconfig.app.json && vite build",
    "start": "electron electron/main.cjs --production",
    "lint": "eslint ."
  },
  "dependencies": {
    "fflate": "^0.8.2",
    "lucide-react": "^1.49.0",
    "pixi.js": "^8.21.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zustand": "^5.0.15",
    "pdfjs-dist": "^6.4.299"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.12.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.3.0",
    "wait-on": "^9.5.1"
  }
}
