generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Workspace {
  // The immutable, shareable join code is the workplace identifier.
  id           String   @id
  worldSeed    String   @unique
  name         String
  private      Boolean  @default(false)
  passwordHash String   @default("")
  passwordSalt String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  spaces       Space[]
  state        WorkspaceState?
  assets       Asset[]
  members      WorkspaceMember[]
}

model Space {
  workspaceId String
  zoneId      String
  name        String
  capacity    Int      @default(8)
  audioMode   String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@id([workspaceId, zoneId])
}

// Bounded application histories; only changed fields are written per event.
// Live positions, device tracks, session tokens and active presentations are ephemeral.
model WorkspaceState {
  workspaceId   String    @id
  messages      Json      @default("[]")
  events        Json      @default("[]")
  notes         Json      @default("[]")
  boards        Json      @default("{}")
  fixtureStates Json      @default("{}")
  library       Json      @default("{\"folders\":[],\"files\":[]}")
  updatedAt     DateTime  @updatedAt
  workspace     Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

model Asset {
  id          String    @id
  workspaceId String
  type        String
  purpose     String    @default("presentation")
  data        Bytes
  createdAt   DateTime  @default(now())
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
}

model User {
  id             String   @id @default(uuid())
  email          String   @unique
  username       String   @unique
  name           String
  passwordHash   String
  dateOfBirth    DateTime? @db.Date
  bio            String   @default("")
  jobTitle       String   @default("")
  company        String   @default("")
  avatar         Json     @default("{}")
  photoData      Bytes?
  photoUpdatedAt DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  sessions       AuthSession[]
  memberships    WorkspaceMember[]
}

model AuthSession {
  tokenHash String   @id
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model WorkspaceMember {
  workspaceId String
  userId      String
  role        String    @default("member")
  joinedAt    DateTime  @default(now())
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@id([workspaceId, userId])
  @@index([userId])
}
